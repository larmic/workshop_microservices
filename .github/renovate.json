{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^services/slides/index\\.html$/"
      ],
      "matchStrings": [
        "cdn\\.jsdelivr\\.net/npm/(?<depName>reveal\\.js)@(?<currentValue>[0-9.]+)/"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^services/booking/custom/build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "jvmToolchain\\((?<currentValue>\\d+)\\)"
      ],
      "depNameTemplate": "java",
      "datasourceTemplate": "java-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/gates\\.sh$/"
      ],
      "matchStrings": [
        "HTML_VALIDATE_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "html-validate",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/vendor-marked\\.sh$/"
      ],
      "matchStrings": [
        "MARKED_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "marked",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/gates\\.yml$/"
      ],
      "matchStrings": [
        "node-version:\\s*['\"](?<currentValue>\\d+)['\"]"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "dependencyDashboardCategory": "Automerge",
      "addLabels": ["automerge"]
    },
    {
      "matchUpdateTypes": ["pin", "pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardCategory": "Manuell prüfen",
      "addLabels": ["manuell prüfen"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "Docker images"
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "groupName": "Kotlin/Gradle dependencies"
    },
    {
      "matchPackageNames": ["eclipse-temurin", "java"],
      "matchUpdateTypes": ["major"],
      "groupName": "Java toolchain major upgrade"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["java"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["marked"],
      "automerge": false,
      "dependencyDashboardCategory": "Manuell prüfen",
      "addLabels": ["manuell prüfen"],
      "prBodyNotes": [
        "Die Datei `pages/vorbereitung/vendor/marked.min.js` liegt im Repo. Auf diesem Branch `scripts/vendor-marked.sh` ausführen und die Datei mit committen, sonst schlägt das Guard-Gate `js` fehl."
      ]
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["reveal.js"],
      "groupName": "reveal.js",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["reveal.js"],
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "dependencyDashboardCategory": "Manuell prüfen",
      "addLabels": ["manuell prüfen"]
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["reveal.js"],
      "matchUpdateTypes": ["major"],
      "groupName": "reveal.js (major)",
      "dependencyDashboardApproval": true
    }
  ]
}
