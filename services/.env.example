CUSTOM_BOOKING_PATH=./booking/custom
# Damit `docker compose logs ...` und Co. im Ordner services/ ohne die vielen
# -f-Flags funktionieren. Die make-Targets setzen ihre Dateien selbst.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.infra.yml:docker-compose.reference.yml:docker-compose.custom.yml
